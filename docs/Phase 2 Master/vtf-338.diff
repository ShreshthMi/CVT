+# =====================================================
+# PDQ workbook contract  (Phase 2 / BE-01)
+# WHERE the parser finds things in the PDQ workbook: sheet names + the content
+# anchors it scans for. Kept separate from pdq-mappings.properties (which is HOW
+# values transform). If AE renames a tab or rewors a header label, edit it here —
+# no recompile. The parser still locates columns/rows by these labels (content
+# anchoring), so inserting/moving rows or columns needs no change at all.
+# =====================================================
+
+# --- Sheet names (in-scope tabs) ---
+sheet.pdq=PDQ
+sheet.cqir=CQ-IR
+sheet.controlTable=Control table
+sheet.dataTransmission=Data transmission Inputs
+
+# --- CQ-IR: the parser finds these columns by scanning the header row for these labels ---
+cqir.header.configWord=Configuration Word
+cqir.header.response=Response
+cqir.header.remarks=Remarks
+
+# --- PDQ structured table: column header labels ---
+pdq.header.slNo=Sl. No.
+pdq.header.response=Response
+
+# --- PDQ header: Project Code label. Value is read from the cell to its right
+#     (merges resolved); blank -> "0". Anchored on the label, not a fixed cell. ---
+pdq.projectCode.label=Project Code
+
+# --- PDQ structured rows anchored by Sl. No. (System Redundancy dropped in frozen Ver14) ---
+pdq.slNo.aebEquipmentVersion=1.09
+
+# --- Data Transmission Inputs: sub-table section anchors (BE-02 locates the two sub-tables by these) ---
+dt.section.dataSafetyLevels=DATA SAFETY LEVEL
+dt.section.outputDataTransmission=OUTPUT DATA TRANSMISSION
+
+# Data Safety Level sub-table — column header per output field (rename a header -> edit the value)
+dt.dataSafetyLevels.col.dpName=DP NAME
+dt.dataSafetyLevels.col.safetyLevelIn=SAFETY_LEVEL_IN
+dt.dataSafetyLevels.col.safetyLevelOut=SAFETY_LEVEL_OUT
+dt.dataSafetyLevels.col.safeOutFdbckQuad=SAFE_OUT_FDBCK_QUAD
+
+# Output Data Transmission sub-table — column header per output field
+dt.outputDataTransmission.col.sourceDpName=SOURCE DP NAME
+dt.outputDataTransmission.col.nmbrOut=NMBR_OUT
+dt.outputDataTransmission.col.position=POSITION
+
+# --- Control table (frozen PDQ Ver14): Track Sections cols A-I, DP table cols K-N; col J is the empty boundary ---
+controlTable.headerLabel=Track Section Name
+controlTable.trackSections.serialNo=A
+controlTable.trackSections.name=B
+controlTable.trackSections.dpIn=C
+controlTable.trackSections.dpOut=D
+controlTable.trackSections.resetType=E
+controlTable.trackSections.trackOutput=F
+controlTable.trackSections.fadcAutoReset=G
+controlTable.trackSections.logicType=H
+controlTable.trackSections.autoResetByTimer=I
+controlTable.dpTable.serialNo=K
+controlTable.dpTable.name=L
+controlTable.dpTable.position=M
+controlTable.dpTable.eChc=N
