+    private static final String SECTION = "SECTION";
+    private static final String DIR_INV = "DIR_INV";
+    private static final String SLCT_TIMEOUT = "SLCT_TIMEOUT";
+    private static final String LOGIC_TYPE = "LOGIC_TYPE";
